# Copy to `.env` and fill in real values. `.env` is gitignored.
# This file must contain VARIABLE NAMES ONLY — never a real credential value.
#
# Names reuse the main WildfireGuardian repository's where they already exist,
# so an existing `.env` works here unchanged. See docs/DECISIONS.md D-002.

# --- NASA FIRMS active-fire (VIIRS / MODIS) ---
# Obtain a MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Primary name matches main repo src/wildfireguardian/live/firms.py.
FIRMS_MAP_KEY=
# Accepted alias (also honoured by the main repository):
NASA_FIRMS_MAP_KEY=

# --- MOIS disaster-data sharing platform (긴급재난문자 / emergency alerts) ---
# Obtain a service key via the Korean disaster-safety data platform.
# See reports/SOURCE_ACCESS_STATUS.md for the exact acquisition procedure.
SAFETYDATA_API_KEY=

# --- 공공데이터포털 data.go.kr service key (some alert/forest datasets) ---
DATA_GO_KR_SERVICE_KEY=

# --- KMA (Korea Meteorological Administration) ---
# Register: https://apihub.kma.go.kr/ or https://data.kma.go.kr/
KMA_API_KEY=

# --- NMSC / GK2A (National Meteorological Satellite Center) ---
# Satellite product distribution: https://nmsc.kma.go.kr/
NMSC_API_KEY=

# --- NASA Earthdata (archival FIRMS / LAADS DAAC downloads) ---
EARTHDATA_USERNAME=
EARTHDATA_TOKEN=
